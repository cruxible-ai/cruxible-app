{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/record-fixtures.ts",
    "src/api/requests.ts",
    "src/api/schemas.ts",
    "src/api/generated/schema.ts",
    "src/fixtures/key.ts",
    "src/lib/neighborhood.ts",
    "src/lib/change-sets.ts",
    "src/lib/attestation-evidence.ts",
    "src/lib/cruxible-ref.ts",
    "src/lib/type-graph.ts",
    "src/lib/lines.ts"
  ]
}
