{
  "name": "cruxible-ui",
  "description": "Read-only inspection console for a local Cruxible daemon (alpha)",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "@cosmograph/cosmos": "2.0.0-beta.20",
    "@fontsource/merriweather": "^5.2.11",
    "@tanstack/react-query": "^5",
    "@xyflow/react": "^12.11.0",
    "d3-force": "^3.0.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.23.0",
    "openapi-fetch": "^0.13",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^26",
    "msw": "^2",
    "openapi-typescript": "^7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
